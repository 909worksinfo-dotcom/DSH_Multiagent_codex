    "errorCodes": [
      "TEAM_MEMBER_LIMIT",
      "FORMATION_FAILED",
      "CAPABILITY_UNAVAILABLE",
      "BLUEPRINT_REVISION_MISMATCH",
      "RESOURCE_CONFLICT",
      "STALE_REVISION",
      "DELIVERY_FAILED"
